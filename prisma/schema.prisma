// Postgres everywhere (Vercel can't host a SQLite file). Use a free Neon or
// Supabase database; for migrations prefer the direct (non-pooled) URL.
// Status-like columns are plain strings validated in TypeScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Container {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  size        String // "20FT" | "40FT" | "40HC" | "45HC"
  type        String // "DRY" | "REEFER" | "OPEN_TOP" | "FLAT_RACK"
  condition   String // "NEW" | "USED" | "REFURBISHED"
  terminal    String
  priceKobo   Int // money is ALWAYS stored as integer kobo, never floats
  images      String // JSON array of absolute URLs
  stock       Int      @default(1)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active, featured])
}

model Order {
  id                    String    @id @default(cuid())
  // Paystack reference. Unique, unguessable, generated server-side.
  reference             String    @unique
  // Client-supplied key that makes POST /api/checkout safe to retry.
  idempotencyKey        String    @unique
  requestHash           String
  status                String    @default("PENDING") // PENDING | PAID | FAILED | ABANDONED | AMOUNT_MISMATCH | REFUNDED
  currency              String    @default("NGN")
  subtotalKobo          Int
  deliveryKobo          Int
  amountKobo            Int
  customerName          String
  customerEmail         String
  customerPhone         String
  companyName           String?
  fulfilment            String // PICKUP | DELIVERY
  deliveryZone          String?
  deliveryAddress       String?
  // Each Paystack initialize attempt uses a fresh reference (see /api/checkout).
  initAttempts          Int       @default(0)
  paystackAccessCode    String?
  paystackAuthUrl       String?
  paystackTransactionId String?
  channel               String?
  gatewayResponse       String?
  paidAt                DateTime?
  verifyAttempts        Int       @default(0)
  lastVerifiedAt        DateTime?
  // Set when something needs a human (stock conflict, amount mismatch, reversal).
  needsReview           Boolean   @default(false)
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  containerId   String
  title         String // snapshot at time of purchase
  unitPriceKobo Int // snapshot at time of purchase
  quantity      Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  container     Container @relation(fields: [containerId], references: [id])

  @@index([orderId])
}

// Every webhook we accept is recorded once. Used for dedupe + audit trail.
model PaymentEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  type      String
  reference String?
  payload   String
  createdAt DateTime @default(now())

  @@index([reference])
}

model QuoteRequest {
  id          String   @id @default(cuid())
  companyName String
  email       String
  phone       String
  size        String?
  quantity    String
  condition   String
  message     String?
  createdAt   DateTime @default(now())
}

model InspectionRequest {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  terminal      String
  preferredDate DateTime
  containerSlug String?
  notes         String?
  createdAt     DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
