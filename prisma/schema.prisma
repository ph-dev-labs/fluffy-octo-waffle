// Postgres everywhere (Vercel can't host a SQLite file). Use a free Neon or
// Supabase database; for migrations prefer the direct (non-pooled) URL.
// Status-like columns are plain strings validated in TypeScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Container {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  size        String // "20FT" | "40FT" | "40HC" | "45HC"
  type        String // "DRY" | "REEFER" | "OPEN_TOP" | "FLAT_RACK"
  condition   String // "NEW" | "USED" | "REFURBISHED"
  terminal    String
  priceKobo   Int // money is ALWAYS stored as integer kobo, never floats
  images      String // JSON array of absolute URLs
  stock       Int      @default(1)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active, featured])
}

model Order {
  id                    String    @id @default(cuid())
  // Paystack reference. Unique, unguessable, generated server-side.
  reference             String    @unique
  // Client-supplied key that makes POST /api/checkout safe to retry.
  idempotencyKey        String    @unique
  requestHash           String
  status                String    @default("PENDING") // PENDING | PAID | FAILED | ABANDONED | AMOUNT_MISMATCH | REFUNDED
  currency              String    @default("NGN")
  subtotalKobo          Int
  deliveryKobo          Int
  amountKobo            Int
  customerName          String
  customerEmail         String
  customerPhone         String
  companyName           String?
  fulfilment            String // PICKUP | DELIVERY
  deliveryZone          String?
  deliveryAddress       String?
  // Snapshot of how the delivery fee was worked out (see lib/delivery).
  deliveryState         String?
  deliveryArea          String?
  deliveryLat           Float?
  deliveryLng           Float?
  deliveryDistanceKm    Float?
  deliveryMethod        String? // AREA | STATE | DISTANCE | ESTIMATE
  deliveryYard          String?
  // Each Paystack initialize attempt uses a fresh reference (see /api/checkout).
  initAttempts          Int       @default(0)
  paystackAccessCode    String?
  paystackAuthUrl       String?
  paystackTransactionId String?
  channel               String?
  gatewayResponse       String?
  paidAt                DateTime?
  verifyAttempts        Int       @default(0)
  lastVerifiedAt        DateTime?
  // Set when something needs a human (stock conflict, amount mismatch, reversal).
  needsReview           Boolean   @default(false)
  reviewNote            String?
  fulfilmentStatus      String    @default("UNFULFILLED") // UNFULFILLED | PROCESSING | DISPATCHED | DELIVERED | COLLECTED | CANCELLED
  adminNote             String?
  // Set (atomically) when the receipt email is claimed for sending — guarantees one email per order.
  receiptSentAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items   OrderItem[]
  invoice Invoice?

  @@index([status, createdAt])
  @@index([needsReview])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  containerId   String
  title         String // snapshot at time of purchase
  unitPriceKobo Int // snapshot at time of purchase
  quantity      Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  container     Container @relation(fields: [containerId], references: [id])

  @@index([orderId])
}

// Every webhook we accept is recorded once. Used for dedupe + audit trail.
model PaymentEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  type      String
  reference String?
  payload   String
  createdAt DateTime @default(now())

  @@index([reference])
}

model QuoteRequest {
  status      String   @default("NEW") // NEW | HANDLED
  id          String   @id @default(cuid())
  companyName String
  email       String
  phone       String
  size        String?
  quantity    String
  condition   String
  message     String?
  createdAt   DateTime @default(now())
}

model InspectionRequest {
  status        String   @default("NEW") // NEW | HANDLED
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  terminal      String
  preferredDate DateTime
  containerSlug String?
  notes         String?
  createdAt     DateTime @default(now())
}

model ContactMessage {
  status    String   @default("NEW") // NEW | HANDLED
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ── Admin ────────────────────────────────────────────────────────────────

model AdminUser {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  passwordHash       String
  role               String         @default("ADMIN") // OWNER | ADMIN
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           AdminSession[]
  auditLogs          AuditLog[]
}

model AdminSession {
  id        String    @id @default(cuid())
  // SHA-256 of the cookie token; the raw token is never stored.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  action    String // e.g. "container.update"
  target    String? // e.g. container id / order reference
  detail    String?
  ip        String?
  createdAt DateTime   @default(now())
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ── Editable site content ────────────────────────────────────────────────

// State → Area tree. A null price means "inherit": an area falls back to its
// state's price, and a state without a price is priced by distance.
model DeliveryZone {
  id               String         @id @default(cuid())
  code             String         @unique // stable key, e.g. "LAGOS", "LAGOS_LEKKI"
  label            String
  kind             String         @default("STATE") // STATE | AREA | REGION (legacy, pre-0004)
  parentId         String?
  parent           DeliveryZone?  @relation("ZoneTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         DeliveryZone[] @relation("ZoneTree")
  perContainerKobo Int? // per 20ft container; null = inherit / use distance
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@index([parentId])
  @@index([kind, active])
}

// Single row (id = 1): rules for distance-based pricing.
model DeliverySettings {
  id              Int      @id @default(1)
  distanceEnabled Boolean  @default(true)
  yards           String // JSON [{ name, lat, lng }]
  baseFeeKobo     Int
  ratePerKmKobo   Int
  minFeeKobo      Int
  maxFeeKobo      Int
  maxDistanceKm   Int
  roadFactorPct   Int      @default(135) // straight line → road estimate when no routing API
  sizeMultipliers String // JSON { "20FT": 100, "40FT": 150, ... } percent
  updatedAt       DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  type      String // image | video
  url       String
  caption   String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// One invoice per order, issued after delivery/collection.
model Invoice {
  id               String    @id @default(cuid())
  seq              Int       @unique @default(autoincrement())
  number           String    @unique // e.g. INV-2026-00001
  orderId          String    @unique
  containerNumbers String // JSON array: one ISO 6346 number per container unit, in item order
  note             String?
  status           String    @default("DRAFT") // DRAFT | SENT
  issuedAt         DateTime  @default(now())
  sentAt           DateTime?
  sentTo           String?
  sendCount        Int       @default(0)
  createdById      String?
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [id])
}

// ── Truck hire (haulage) ────────────────────────────────────────────────────
// A customer's own container is moved from a pickup pin to a drop-off pin.
// Priced by road distance (HaulageSettings). Paid in full or deposit + balance,
// each instalment being its own Paystack transaction (HaulagePayment).

model HaulageRequest {
  id               String    @id @default(cuid())
  reference        String    @unique // human-friendly, e.g. HL-7K3D9Q
  idempotencyKey   String    @unique
  requestHash      String
  status           String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | CONFIRMED | SCHEDULED | IN_TRANSIT | DELIVERED | CANCELLED
  customerName     String
  customerEmail    String
  customerPhone    String
  companyName      String?
  pickupAddress    String
  pickupLat        Float
  pickupLng        Float
  pickupState      String?
  dropoffAddress   String
  dropoffLat       Float
  dropoffLng       Float
  dropoffState     String?
  containerSize    String
  containerCount   Int
  containerNumbers String?
  preferredDate    DateTime?
  notes            String?
  distanceKm       Float
  priceMethod      String // DISTANCE | ESTIMATE
  perContainerKobo Int
  totalKobo        Int
  depositPct       Int // snapshot of the deposit % offered
  paidKobo         Int       @default(0) // Σ PAID payments, kept in sync by the payment pipeline
  currency         String    @default("NGN")
  scheduledFor     DateTime?
  driverName       String?
  driverPhone      String?
  truckPlate       String?
  adminNote        String?
  needsReview      Boolean   @default(false)
  reviewNote       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments HaulagePayment[]

  @@index([status, createdAt])
  @@index([needsReview])
}

model HaulagePayment {
  id                    String         @id @default(cuid())
  requestId             String
  request               HaulageRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  kind                  String // FULL | DEPOSIT | BALANCE
  reference             String         @unique // Paystack reference, CZ_HL_...
  idempotencyKey        String         @unique
  amountKobo            Int
  currency              String         @default("NGN")
  status                String         @default("PENDING") // same state machine as Order
  initAttempts          Int            @default(0)
  paystackAccessCode    String?
  paystackAuthUrl       String?
  paystackTransactionId String?
  channel               String?
  gatewayResponse       String?
  paidAt                DateTime?
  verifyAttempts        Int            @default(0)
  lastVerifiedAt        DateTime?
  receiptSentAt         DateTime?
  needsReview           Boolean        @default(false)
  reviewNote            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([requestId])
  @@index([status, createdAt])
}

// Single row (id = 1), created by the app on first use.
model HaulageSettings {
  id              Int      @id @default(1)
  enabled         Boolean  @default(true)
  baseFeeKobo     Int
  ratePerKmKobo   Int
  minFeeKobo      Int
  maxFeeKobo      Int
  maxDistanceKm   Int
  sizeMultipliers String // JSON { "20FT": 100, "40FT": 150, ... } percent
  allowDeposit    Boolean  @default(true)
  depositPct      Int      @default(50)
  updatedAt       DateTime @updatedAt
}
