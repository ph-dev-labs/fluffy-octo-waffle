# Copy to .env and fill in. NEVER commit real secrets.

# Postgres connection string (Neon / Supabase / Vercel Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) URL used for migrations during `npm run build`. Vercel's Neon
# integration sets this automatically. Running migrations through a pooler can
# leave a stuck lock that blocks every later deploy.
# DATABASE_URL_UNPOOLED=""

# Optional: separate EMPTY database for `npm test` DB integration tests (wiped each run).
# TEST_DATABASE_URL=""

# Public base URL of the site (used for Paystack callback_url). No trailing slash.
APP_URL="http://localhost:3000"

# Paystack secret key (server-only). Use sk_test_... in dev, sk_live_... in prod.
# Get it from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""

# Webhook URL to configure in the Paystack dashboard:
#   https://<your-domain>/api/payments/webhook

# Optional: comma-separated IP allowlist for the webhook (Paystack publishes theirs).
# PAYSTACK_WEBHOOK_IPS="52.31.139.75,52.49.173.169,52.214.14.220"

# Shared secret for the reconciliation cron (min 32 chars). Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# ── Cloudinary (image/video upload + optimisation) ────────────────────────
# Dashboard → Settings → API Keys. The secret stays server-side.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Root folder for all uploads in your Cloudinary media library
CLOUDINARY_FOLDER="czuchi"

# ── Email (Resend — https://resend.com) ───────────────────────────────────
RESEND_API_KEY=""
# Must be on a domain verified in Resend, e.g. "C-ZUCHI <orders@c-zuchigrp.com>"
MAIL_FROM=""
# Comma-separated staff inboxes that get new-order / quote / inspection alerts
MAIL_ADMIN_TO=""

# ── First admin account (used by `npm run db:seed`) ───────────────────────
# If ADMIN_SEED_PASSWORD is empty, a strong random password is generated and
# printed ONCE. The admin must change it at first login.
ADMIN_SEED_EMAIL="admin@c-zuchigrp.com"
ADMIN_SEED_NAME="C-ZUCHI Admin"
ADMIN_SEED_PASSWORD=""

# ── SEO ───────────────────────────────────────────────────────────────────
# Google Search Console "HTML tag" verification code (just the content value)
GOOGLE_SITE_VERIFICATION=""

# ── Delivery pricing (optional) ──────────────────────────────────────────
# Free key from https://openrouteservice.org (sign up → Dashboard → API key).
# With it, delivery distance = real truck road distance; without it, a
# straight-line estimate × the admin's road factor is used.
ORS_API_KEY=""
# Signs delivery quotes. Optional: falls back to a key derived from PAYSTACK_SECRET_KEY.
QUOTE_SIGNING_SECRET=""

